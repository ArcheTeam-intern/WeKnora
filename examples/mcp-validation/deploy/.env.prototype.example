# WeKnora service configuration; no Agent app or model configuration.
COMPOSE_PROJECT_NAME=weknora-agent-prototype
WEKNORA_SOURCE_DIR=../../..
WEKNORA_DOCKERFILE=examples/mcp-validation/deploy/Dockerfile.prototype-app
WEKNORA_VERSION=v0.8.2
BASE_REGISTRY=
APK_MIRROR_ARG=mirrors.tencent.com
GOPROXY_ARG=https://goproxy.cn,direct
GOSUMDB_ARG=off
RUSTUP_DIST_SERVER_ARG=https://mirrors.tuna.tsinghua.edu.cn/rustup
RUSTUP_UPDATE_ROOT_ARG=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
CARGO_REGISTRY_MIRROR_ARG=sparse+https://rsproxy.cn/index/
WITH_ANYDOC=1
PROTOTYPE_WEKNORA_PORT=18082
PROTOTYPE_WEKNORA_UI_PORT=18180
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=
WEKNORA_BOOTSTRAP_SYSTEM_ADMIN_EMAIL=
NEO4J_ENABLE=true
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
PROTOTYPE_REDIS_PASSWORD=
MAX_FILE_SIZE_MB=50
LOG_LEVEL=info
GIN_MODE=release
DEFAULT_LOCALE=zh-CN
SSRF_WHITELIST_EXTRA=neo4j,redis,198.18.0.0/15
DISABLE_REGISTRATION=false
WEKNORA_CHECK_TAGS=sqlite_fts5
WEKNORA_CHECK_PKGS=
WEKNORA_CHECK_EXTRA=
